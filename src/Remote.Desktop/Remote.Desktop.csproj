<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remote.Application\Remote.Application.csproj" />
    <ProjectReference Include="..\Remote.Infrastructure\Remote.Infrastructure.csproj" />
    <ProjectReference Include="..\Remote.Protocols\Remote.Protocols.csproj" />
  </ItemGroup>

  <Target Name="BuildMacOsFreeRdpBridge" BeforeTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MakeDir Directories="$(TargetDir)" />
    <Exec Command="clang -dynamiclib -O2 -fvisibility=hidden -I/opt/homebrew/include/freerdp3 -I/opt/homebrew/include/winpr3 &quot;$(MSBuildProjectDirectory)/../../native/macos/remote_freerdp_bridge.c&quot; -L/opt/homebrew/lib -lfreerdp-client3 -lfreerdp3 -lwinpr3 -Wl,-rpath,/opt/homebrew/lib -o &quot;$(TargetDir)libremote-freerdp.dylib&quot;" />
  </Target>

  <Target Name="BundleMacOsFreeRdpRuntime" AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Copy SourceFiles="$(TargetDir)libremote-freerdp.dylib" DestinationFolder="$(PublishDir)" />
    <Exec Command="&quot;$(MSBuildProjectDirectory)/../../native/macos/bundle-freerdp-runtime.sh&quot; &quot;$(PublishDir)&quot;" />
  </Target>
</Project>
